# Local development only; use a private managed PostgreSQL URL in production.
DATABASE_URL=postgresql://rpm@127.0.0.1:55432/rpm_club
# Optional trusted database CA certificate, encoded as base64 (required for Supabase).
DATABASE_SSL_CA_BASE64=
TEST_DATABASE_URL=postgresql://rpm@127.0.0.1:55432/rpm_club_test
APP_URL=http://127.0.0.1:3001
LOCAL_PREVIEW=0
# Generate independent random values, at least 32 bytes each.
SESSION_SECRET=
ENCRYPTION_KEY=
INTEGRATION_API_KEY=
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=rpm-offers
# Commercial weather forecast API. Used only when the weather trigger is enabled.
OPEN_METEO_API_KEY=
SUPPORT_URL=https://rpmrent.ru
CATALOG_URL=https://rpmrent.ru/cars
