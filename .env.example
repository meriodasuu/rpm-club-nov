# Local development. Production uses the isolated PostgreSQL service on the VPS.
DATABASE_URL=postgresql://rpm@127.0.0.1:55432/rpm_club
# Optional trusted CA for an external TLS database.
DATABASE_SSL_CA_BASE64=
# Set to 1 only with the private Docker hostname rpm-club-db.
DATABASE_PRIVATE_NETWORK=0
# Absolute persistent path in production; development defaults to .local/media.
MEDIA_DIR=
TEST_DATABASE_URL=postgresql://rpm@127.0.0.1:55432/rpm_club_test
APP_URL=http://127.0.0.1:3001
# Keep prize issuance off until the owner approves the economic rules.
ROULETTE_ECONOMICS_APPROVED=0
LOCAL_PREVIEW=0
# Generate independent random values, at least 32 bytes each.
SESSION_SECRET=
ENCRYPTION_KEY=
INTEGRATION_API_KEY=
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Commercial weather forecast API. Used only when the weather trigger is enabled.
OPEN_METEO_API_KEY=
SUPPORT_URL=https://rpmrent.ru
CATALOG_URL=https://rpmrent.ru/cars
