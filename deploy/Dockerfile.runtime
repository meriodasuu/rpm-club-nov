# Build node_modules and .next on Linux first; see VPS-RELEASE.md.
ARG NODE_IMAGE=node:22-bookworm-slim
FROM ${NODE_IMAGE}
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --chown=node:node package.json package-lock.json next.config.ts next-env.d.ts tsconfig.json ./
COPY --chown=node:node node_modules ./node_modules
COPY --chown=node:node .next ./.next
COPY --chown=node:node public ./public
COPY --chown=node:node src ./src
COPY --chown=node:node scripts ./scripts
COPY --chown=node:node db ./db
USER node
EXPOSE 3001
CMD ["sh", "-c", "node --import tsx scripts/check-production.ts && exec node node_modules/next/dist/bin/next start --hostname 0.0.0.0 --port 3001"]
