# Replace club.example.com after agreeing the hostname and issuing its certificate.
# Include inside nginx's http context. The application listens on loopback only.
server {
    listen 80;
    server_name club.example.com;
    access_log off;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://club.example.com$request_uri; }
}

server {
    listen 443 ssl;
    server_name club.example.com;
    ssl_certificate /etc/letsencrypt/live/club.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/club.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Import is up to 10 MiB plus multipart envelope; photos up to 5 MiB.
    client_max_body_size 12m;
    client_body_timeout 30s;
    client_header_timeout 15s;
    keepalive_timeout 30s;

    # Do not log URL query strings: admin/browser compatibility links can carry codes.
    access_log off;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 75s;
    }
}
