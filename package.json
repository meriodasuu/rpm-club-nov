{
  "name": "rpm-club",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "jobs": "tsx --env-file=.env.local scripts/jobs.ts",
    "test:integration": "node scripts/test-integration.mjs",
    "staff:bootstrap": "tsx --env-file=.env.local scripts/bootstrap-staff.ts",
    "format:check": "prettier --check src/components src/lib/api src/lib/auth src/lib/imports src/app",
    "setup:local": "node scripts/setup-local.mjs",
    "smoke:local": "node scripts/smoke-local.mjs",
    "telegram:setup": "tsx --env-file=.env.local scripts/telegram-setup.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "jose": "6.2.12",
    "lucide-react": "1.44.0",
    "motion": "13.2.0",
    "next": "16.3.4",
    "otpauth": "9.5.2",
    "papaparse": "5.7.0",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
